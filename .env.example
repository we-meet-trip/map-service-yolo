GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# 식별 한 번에 허용할 시간. 아래 JOB_TIMEOUT_SECONDS 보다 작아야 한다.
GEMINI_TIMEOUT_SECONDS=25.0
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# YOLO 가중치는 컨테이너 이미지에 내장된다(Dockerfile 의 bake 단계).
# 다른 가중치를 쓰려면 파일을 마운트하고 이 경로를 함께 바꾼다.
YOLO_MODEL_PATH=models/yolo11n.pt
YOLO_CONFIDENCE=0.5

# 요청 하나의 전체 시간. 식별 한도보다 커야 한다 — 같으면 식별을 마치고도
# 검색 도중 잘려 이미 얻은 결과가 통째로 버려진다.
JOB_TIMEOUT_SECONDS=45.0
