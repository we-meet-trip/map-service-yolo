GEMINI_API_KEY=your_gemini_api_key_here
# 이전 기본값 gemini-2.5-flash 는 2026-10-16 폐기 예정이라 그 뒤에 만든 환경은
# 장소 인식 답변이 통째로 멈춘다. 폐기일이 없는 판으로 기본값을 옮겼다.
GEMINI_MODEL=gemini-3.8-flash
# 식별 한 번에 허용할 시간. 아래 JOB_TIMEOUT_SECONDS 보다 작아야 한다.
GEMINI_TIMEOUT_SECONDS=25.0
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# YOLO 가중치는 컨테이너 이미지에 내장된다(Dockerfile 의 bake 단계).
# 다른 가중치를 쓰려면 파일을 마운트하고 이 경로를 함께 바꾼다.
YOLO_MODEL_PATH=models/yolo11n.pt
YOLO_CONFIDENCE=0.5

# 요청 하나의 전체 시간. 식별 한도보다 커야 한다 — 같으면 식별을 마치고도
# 검색 도중 잘려 이미 얻은 결과가 통째로 버려진다.
JOB_TIMEOUT_SECONDS=45.0

# User 서비스와 동일한 전용 내부 토큰. 비어 있으면 부팅을 거절한다.
USER_SERVICE_BASE_URL=http://user:8080
VISION_INTERNAL_TOKEN=
VISION_PERMIT_TIMEOUT_SECONDS=5
VISION_MAX_CONCURRENT_JOBS=2
WS_MAX_JOBS_PER_CONNECTION=60
WS_MAX_MESSAGES_PER_CONNECTION=240
WS_IDLE_TIMEOUT_SECONDS=120
